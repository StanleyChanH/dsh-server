# Public entry points of the dsh-server stack: HTTPS on 443, plus the 80 -> 443
# redirect that Caddy adds on its own. Both are reachable on a private network
# only. The listener of a Cloudflare Tunnel, when one is added, is at the end
# of this file.
#
# The site address is an environment placeholder, so the whole stack takes its
# host from one place: DSH_TRUSTED_HOST in .env (compose.yml passes it into
# this container). The value must be an IP address or hostname, without scheme
# or port: the stack always serves 443.
#
# TLS comes from Caddy's internal CA, so this works on a bare IP without a
# domain. The root certificate is written to
# caddy/data/caddy/pki/authorities/local/root.crt on the host; hand it to
# members to import.

# admin off: this deployment never changes its configuration at run time, so
# the admin API would only be one more local listener.
#
# default_sni: a browser or curl talking to a bare IP sends no SNI (RFC 6066
# forbids IP literals there), and without an SNI Caddy cannot choose a
# certificate: the handshake fails with "alert internal error" (curl reports
# 000 / exit 35). Pinning the default SNI to the site host makes the single
# internal certificate match even for a ClientHello without SNI.
{
	admin off
	default_sni {$DSH_TRUSTED_HOST}
}

# Everything behind the login gate, for one listener. The argument names a
# snippet that every proxy in the chain imports, so a listener can add to what
# the proxies send upstream; nothing else differs between listeners.
#
# auth-gate takes the client address, for the login rate limit, from the first
# element of X-Forwarded-For. That is why the address has to be right on all
# three hops below, not only on the way to dsh: the login request itself goes
# through the first one.
(routes) {
	# No `encode` anywhere, on purpose: dsh answers with SSE and WebSocket
	# streams, and compressing them buffers the stream and breaks real-time
	# delivery. Caddy does not enable encoding by default; this note is here so
	# that nobody adds it.

	# Login-gate endpoints go straight to auth-gate. Its handlers already live
	# at /auth/login, /auth/check and /auth/ping, so no prefix is stripped.
	handle /auth/* {
		reverse_proxy auth-gate:8080 {
			import {args[0]}
		}
	}

	# Everything else passes auth-gate's forward_auth check first. A GET
	# without a valid session is answered with 302 + Location to the login page
	# (a browser only navigates on 3xx); any other method gets 401. Caddy
	# forwards that answer to the browser unchanged and only talks to dsh once
	# the gate has said 200.
	handle {
		forward_auth auth-gate:8080 {
			uri /auth/check
			import {args[0]}
		}
		# Automatic sign-in: dsh answers 401 to every request that carries no
		# valid token or cookie (and a browser does not navigate on 401), so the
		# 401 is rewritten here into a 302 to /auth/dsh-entry. auth-gate hands
		# out the current token and sends the member back to /?token=<current>.
		# This applies to every 401 dsh produces (a deliberate choice: it
		# matches browser semantics). The token is synced once a minute by a
		# host cron job running scripts/sync-token.sh. Responses that are not
		# 401 pass through untouched, including SSE and WebSocket.
		reverse_proxy dsh:3080 {
			import {args[0]}
			@dsh_unauth status 401
			handle_response @dsh_unauth {
				# A `redir` whose first argument starts with "/" is parsed as a
				# path matcher; attached to the original request path "/" it
				# never matches and turns into an empty 200. The explicit "*"
				# means "redirect unconditionally".
				redir * /auth/dsh-entry 302
			}
		}
	}
}

# Client address on the private network: the peer of the connection. For a
# connection that does not come from a trusted proxy, the reverse proxy throws
# away any X-Forwarded-For the client sent and writes the peer's address
# there, which is exactly what this listener needs, so there is nothing to
# add. (Writing it down as `header_up X-Forwarded-For {remote_host}` would
# say the same thing; Caddy logs a warning that it is unnecessary.)
(xff_peer) {
}

# Client address on the tunnel: Cloudflare's edge adds Cf-Connecting-Ip, the
# visitor's address, to every request it forwards. X-Forwarded-For is not
# used: when a request already carries one, Cloudflare appends the visitor's
# address to it, so its first element is whatever the visitor chose to send.
(xff_cloudflare) {
	header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
}

https://{$DSH_TRUSTED_HOST} {
	tls internal
	import routes xff_peer
}

# Cloudflare Tunnel (compose.tunnel.yml: a cloudflared container, on its own
# Compose network). This listener is the only thing that container can reach;
# the public hostname in the Cloudflare dashboard has to point to
# http://caddy:8080. It is not published, so on this host only containers on
# the Compose networks can reach it, and the login gate applies exactly as on
# the private listener.
#
# The Host header is the public hostname and is passed on to dsh, which has to
# trust it (TUNNEL_HOSTNAME in .env). A request that arrives without
# Cf-Connecting-Ip reaches the backends with an empty X-Forwarded-For;
# auth-gate then counts all such requests as one client.
http://:8080 {
	import routes xff_cloudflare
}
