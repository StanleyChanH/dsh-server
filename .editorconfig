# Editor configuration, https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 4

# gofmt formats with tabs; the Caddyfile is indented with tabs as well.
[*.go]
indent_style = tab

[Caddyfile]
indent_style = tab
